generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ServiceType {
  id     Int     @id @default(autoincrement())
  name   Json
  slug   String  @unique
  icon   String?
  status Int     @default(1)

  businesses BusinessServiceType[]
}

model BusinessServiceType {
  businessId    String
  serviceTypeId Int
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([businessId, serviceTypeId])
}

model Business {
  id                 String   @id @default(uuid())
  name               String?
  ownerName          String?
  sameAsOwnerNumber  Boolean  @default(false)
  contactNumber      String?
  email              String?
  address            String?
  cateringTypes      String[] @default([])
  yearsExperience    Int?
  registrationNumber String?
  gstNumber          String?
  logoUrl            String?
  termsAndConditions String?  @db.Text

  subscriptionStatus String?   @default("trial")
  subscriptionPlan   String?   @default("FREE")
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  isTrialUsed        Boolean   @default(false)
  razorpayCustomerId String?

  createdByUserId String?
  createdBy       User?   @relation("BusinessCreatedBy", fields: [createdByUserId], references: [id])

  isProfileCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultServiceChargePct Decimal @default(10) @db.Decimal(5, 2)
  defaultTaxPct           Decimal @default(5) @db.Decimal(5, 2)

  users                User[]
  serviceLinks         BusinessServiceType[]
  menuItems            MenuItem[]
  dishes               Dish[]
  bookings             Booking[]
  quotations           Quotation[]
  supplyItems          SupplyItem[]
  supplySavedLists     SupplySavedList[]
  vendors              Vendor[]
  staff                Staff[]
  extraServices        ExtraService[]
  billingSubscriptions BillingSubscription[]
  billingPaymentEvents BillingPaymentEvent[]
}

/// Mirrors Razorpay subscription; one row per active/historical app subscription.
model BillingSubscription {
  id                     String    @id @default(uuid())
  businessId             String
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  razorpaySubscriptionId String    @unique
  razorpayPlanId         String
  planCode               String?
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  paymentEvents BillingPaymentEvent[]

  @@index([businessId])
}

model BillingPaymentEvent {
  id                    String               @id @default(uuid())
  businessId            String
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billingSubscriptionId String?
  billingSubscription   BillingSubscription? @relation(fields: [billingSubscriptionId], references: [id], onDelete: SetNull)
  razorpayPaymentId     String?              @unique
  razorpayInvoiceId     String?
  amountPaise           BigInt               @default(0)
  status                String
  rawWebhookEventId     String?
  createdAt             DateTime             @default(now())

  @@index([businessId])
  @@index([billingSubscriptionId])
}

/// Razorpay webhook dedupe + debugging (idempotent processing).
model WebhookInbox {
  id          String    @id @default(uuid())
  eventId     String    @unique
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

model User {
  id                 String    @id @default(uuid())
  businessId         String?
  name               String
  email              String    @unique
  passwordHash       String
  phoneNumber        String?
  profileImageUrl    String?
  pdfPrefix          String?   @default("KAT-2024")
  role               String    @default("owner")
  language           String    @default("gu")
  isVerified         Boolean   @default(false)
  notificationStatus Int       @default(1)
  userVerifiedAt     DateTime?
  sessionVersion     Int       @default(0)
  deviceToken        String?
  deviceType         Int?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business                Business?            @relation(fields: [businessId], references: [id])
  businessesCreated       Business[]           @relation("BusinessCreatedBy")
  menuItemsCreated        MenuItem[]
  supplyItemsCreated      SupplyItem[]
  supplySavedListsCreated SupplySavedList[]    @relation("SupplySavedListCreator")
  extraServicesCreated    ExtraService[]
  contactMessages         ContactMessage[]
  accessCodesAssigned     AccessCode[]         @relation("AccessCodeAssignedUser")
  notificationLogsCreated NotificationLog[]    @relation("NotificationLogCreator")
  userNotifications       UserNotification[]
  onboardingReminders     OnboardingReminder[]
}

/// Admin-generated subscription access codes (6-digit) for caterer onboarding.
model AccessCode {
  id             String    @id @default(uuid())
  code           String    @unique
  planType       String
  status         String    @default("unused")
  assignedUserId String?
  assignedUser   User?     @relation("AccessCodeAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([planType])
  @@index([assignedUserId])
}

/// Per-user notification inbox — stores every push sent to a caterer.
model UserNotification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  type      String // "event_reminder" | "admin_broadcast"
  data      Json? // { bookingId?, bookingEventId?, notificationLogId? }
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
}

/// Admin broadcast notifications — log of title/message and audience size.
model NotificationLog {
  id              String   @id @default(uuid())
  title           String
  message         String   @db.Text
  priority        String   @default("normal")
  sentTo          String   @default("all-users")
  sentCount       Int      @default(0)
  tokensCount     Int      @default(0)
  createdByUserId String?
  createdBy       User?    @relation("NotificationLogCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

/// Admin audit trail (login, codes, payments, etc.).
model ActivityLog {
  id          String   @id @default(uuid())
  type        String
  message     String   @db.Text
  meta        Json?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt(sort: Desc)])
}

/// Singleton global settings (admin-managed).
model AppSettings {
  id           String   @id @default("default")
  appName      String   @default("Katmitra")
  supportEmail String   @default("support@katmitra.com")
  paymentUpi   String   @default("")
  paymentBank  String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  defaultServiceChargePct Decimal @default(10) @db.Decimal(5, 2)
  defaultTaxPct           Decimal @default(5) @db.Decimal(5, 2)
}

/// Per-platform mobile app version gates (admin-managed; env vars are fallback).
model AppVersionConfig {
  id             String   @id @default(uuid())
  platform       String   @unique
  latestVersion  String
  minimumVersion String
  updateMessage  String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id           String   @id @default(uuid())
  email        String?
  customerName String
  phone        String?
  businessName String?
  address      String?
  description  String?
  status       String   @default("open")
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model MenuItem {
  /// Server-generated UUID; not accepted from clients on create.
  id              String  @id @default(uuid())
  name            Json
  description     String? @db.Text
  howToMake       String? @db.Text
  pricePerPerson  Decimal @db.Decimal(12, 2)
  categorySlug    String
  foodType        String
  businessId      String?
  createdByUserId String?
  /// false only when both businessId and createdByUserId are set; otherwise true (catalog / import).
  isGlobal        Boolean @default(false)
  parentMenuId    String?
  ingredients     Json    @default("[]")
  imageUrl        String?

  business           Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation(fields: [createdByUserId], references: [id])
  category           MenuCategory        @relation(fields: [categorySlug], references: [slug])
  parentMenu         MenuItem?           @relation("MenuItemLineage", fields: [parentMenuId], references: [id])
  childCopies        MenuItem[]          @relation("MenuItemLineage")
  bookingMenuItems   BookingMenuItem[]
  quotationMenuItems QuotationMenuItem[]
  dishMenuItems      DishMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([createdByUserId])
  @@index([isGlobal])
  @@index([parentMenuId])
  @@index([categorySlug])
}

/// Global menu categories (admin-managed). Names are localized JSON maps.
model MenuCategory {
  id        String     @id @default(uuid())
  name      Json
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  RECEIVED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum EventStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

enum SupplyItemType {
  INGREDIENT
  UTENSIL
}

enum QuotationStatus {
  DRAFT
  SALE
  SENT
  ACCEPTED
}

enum StaffRole {
  CHEF
  HELPER
  WAITER
  MANAGER
  CLEANER
  VIP_SERVICE_BOY
  COUNTER_STAFF
  DECORATION_STAFF
}

enum StaffStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
  INACTIVE
}

enum ExtraServicePricingType {
  FIXED
  PER_UNIT
  PER_GUEST
}

model Booking {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status      BookingStatus @default(DRAFT)
  stepNumber  Int           @default(1)
  bookingCode String?

  customerName    String?
  customerPhone   String?
  customerEmail   String?
  /// Customer's own address (billing / contact). Independent of any event venue.
  /// An event with no `eventLocation` of its own inherits this at read time.
  customerAddress String?
  eventRangeStart DateTime?
  eventRangeEnd   DateTime?

  eventAt DateTime?
  /// @deprecated Legacy booking-level default venue. Kept for back-compat only —
  /// backfilled into `customerAddress`; new writes go there instead.
  eventLocation String?
  functionType  String?
  guestCount    Int?
  notes         String?   @db.Text

  discountAmount      Decimal       @default(0) @db.Decimal(12, 2)
  serviceChargePct    Decimal       @default("10") @db.Decimal(5, 2)
  taxPct              Decimal       @default("5") @db.Decimal(5, 2)
  subtotal            Decimal       @default(0) @db.Decimal(12, 2)
  serviceChargeAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(12, 2)
  totalDue            Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid          Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus       PaymentStatus @default(PENDING)

  menuItems         BookingMenuItem[]
  supplyItems       BookingSupplyItem[]
  payments          PaymentTransaction[]
  events            BookingEvent[]
  extraServiceLines BookingExtraServiceLine[]
  bookingReminders  BookingReminder[]

  /// Set when the caterer marks the booking as completed in the app (dashboard / history).
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, bookingCode])
  @@index([businessId, status])
  @@index([businessId, eventAt])
  @@index([businessId, completedAt])
}

model BookingEvent {
  id            String      @id @default(uuid())
  bookingId     String
  eventAt       DateTime?
  eventLocation String?
  functionType  String?
  jamanvarType  String?
  guestCount    Int?
  notes         String?     @db.Text
  status        EventStatus @default(PENDING)
  dishId        String?
  parentDishId  String?
  isTemplate    Boolean?
  eventTotal    Decimal?    @db.Decimal(12, 2)
  eventSnapshot Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  booking           Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  supplyItems       BookingEventSupplyItem[]
  supplySavedLists  SupplySavedList[]
  staffAssignments  EventStaff[]
  extraServiceLines BookingExtraServiceLine[]
  eventReminders    EventReminder[]

  @@index([bookingId])
  @@index([bookingId, eventAt])
  @@index([eventAt])
}

/// Tracks which reminder notifications have been sent per booking event.
/// @@unique([bookingEventId, reminderType]) is the primary dedup guard —
/// only one reminder of each type can ever be inserted per event.
model EventReminder {
  id             String       @id @default(uuid())
  bookingEventId String
  bookingEvent   BookingEvent @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  reminderType   String // "24_HOUR" | "2_HOUR" | "30_MINUTE"
  sentAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([bookingEventId, reminderType])
  @@index([bookingEventId])
  @@index([reminderType, sentAt])
}

model BookingMenuItem {
  id                    String  @id @default(uuid())
  bookingId             String
  menuItemId            String
  quantity              Int     @default(1)
  pricePerPlateSnapshot Decimal @db.Decimal(12, 2)
  nameSnapshot          String?
  imageUrlSnapshot      String?

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([bookingId, menuItemId])
  @@index([bookingId])
}

model SupplyItem {
  id              String             @id @default(uuid())
  businessId      String?
  business        Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?              @relation(fields: [createdByUserId], references: [id])
  /// false only when both businessId and createdByUserId are set; otherwise true (catalog / import).
  isGlobal        Boolean            @default(false)
  type            SupplyItemType
  categorySlug    String
  category        SupplyItemCategory @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  name            Json
  unitOptions     String[]           @default([])
  defaultUnit     String
  availableCount  Int?
  damagedCount    Int                @default(0)
  photoUrl        String?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  bookingSupplyItems      BookingSupplyItem[]
  bookingEventSupplyItems BookingEventSupplyItem[]
  supplySavedListItems    SupplySavedListItem[]

  @@index([businessId])
  @@index([createdByUserId])
  @@index([isGlobal])
  @@index([businessId, type, categorySlug, isActive])
  @@index([categorySlug])
}

model BookingSupplyItem {
  id           String             @id @default(uuid())
  bookingId    String
  supplyItemId String
  quantity     Int                @default(1)
  unit         String
  categorySlug String
  category     SupplyItemCategory @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  nameSnapshot Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)

  @@unique([bookingId, supplyItemId])
  @@index([bookingId, categorySlug])
  @@index([categorySlug])
}

model BookingEventSupplyItem {
  id             String             @id @default(uuid())
  bookingEventId String
  supplyItemId   String
  itemType       SupplyItemType
  /// Ingredient quantities may be fractional (e.g. 1.5 kg); utensils stay
  /// whole numbers by application-layer validation, not by the column type.
  quantity       Float              @default(1)
  unit           String
  categorySlug   String
  category       SupplyItemCategory @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  nameSnapshot   Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  bookingEvent BookingEvent @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  supplyItem   SupplyItem   @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)

  @@unique([bookingEventId, supplyItemId])
  @@index([bookingEventId, itemType])
  @@index([categorySlug])
}

/// Supply categories are admin-managed and referenced by slug from supply tables.
model SupplyItemCategory {
  id        String   @id @default(uuid())
  name      Json
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplyItems             SupplyItem[]
  bookingSupplyItems      BookingSupplyItem[]
  bookingEventSupplyItems BookingEventSupplyItem[]

  @@index([isActive, sortOrder])
}

/// Admin-managed Units catalog used globally across modules.
model Unit {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Units")
}

model Dish {
  id                            String         @id @default(uuid())
  businessId                    String
  business                      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                          String
  pricePerPlate                 Decimal        @default(0) @db.Decimal(12, 2)
  isTemplate                    Boolean        @default(true)
  parentDishId                  String?
  parentDish                    Dish?          @relation("DishLineage", fields: [parentDishId], references: [id])
  childDishes                   Dish[]         @relation("DishLineage")
  menuItems                     DishMenuItem[]
  requiredIngredients           Json           @default("[]") // dish-level totals; does not modify MenuItem.ingredients
  requiredIngredientsCustomized Boolean        @default(false)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  @@index([businessId])
  @@index([parentDishId])
  @@index([businessId, isTemplate, updatedAt(sort: Desc)])
}

model DishMenuItem {
  id          String   @id @default(uuid())
  dishId      String
  menuItemId  String
  quantity    Int      @default(1)
  ingredients Json     @default("[]") // per-dish ingredient overrides for this menu item; independent of MenuItem.ingredients
  dish        Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([dishId, menuItemId])
  @@index([dishId])
}

model PaymentTransaction {
  id        String        @id @default(uuid())
  bookingId String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Quotation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  status QuotationStatus @default(SALE)

  clientName          String
  clientPhone         String?
  clientEmail         String?
  clientAddress       String?
  functionType        String?
  eventDate           DateTime?
  guestCount          Int       @default(0)
  discountAmount      Decimal   @default(0) @db.Decimal(12, 2)
  serviceChargePct    Decimal   @default("10") @db.Decimal(5, 2)
  taxPct              Decimal   @default("5") @db.Decimal(5, 2)
  subtotal            Decimal   @db.Decimal(12, 2)
  serviceChargeAmount Decimal   @db.Decimal(12, 2)
  taxAmount           Decimal   @db.Decimal(12, 2)
  total               Decimal   @db.Decimal(12, 2)
  /// Agreed per-guest menu bundle (custom or predefined); null when only per-line catalog snapshots apply.
  platePrice          Decimal?  @db.Decimal(12, 2)

  menuItems          QuotationMenuItem[]
  quotationReminders QuotationReminder[]
  events             QuotationEvent[]
  extraServiceLines  QuotationExtraServiceLine[]

  /// Set once this quotation has been converted into a real Booking (client approved). Guards against duplicate conversion.
  convertedBookingId String?   @unique
  convertedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model QuotationMenuItem {
  id                    String  @id @default(uuid())
  quotationId           String
  menuItemId            String
  pricePerPlateSnapshot Decimal @db.Decimal(12, 2)
  nameSnapshot          String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([quotationId, menuItemId])
  @@index([quotationId])
}

/// Mirrors BookingEvent: one quotation can span multiple sessions (breakfast/lunch/dinner),
/// each with its own date/menu snapshot, so a client can be quoted for a multi-event order.
model QuotationEvent {
  id            String      @id @default(uuid())
  quotationId   String
  eventAt       DateTime?
  eventLocation String?
  functionType  String?
  jamanvarType  String?
  guestCount    Int?
  notes         String?     @db.Text
  status        EventStatus @default(PENDING)
  dishId        String?
  parentDishId  String?
  isTemplate    Boolean?
  eventTotal    Decimal?    @db.Decimal(12, 2)
  eventSnapshot Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  quotation         Quotation                   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  extraServiceLines QuotationExtraServiceLine[]

  @@index([quotationId])
  @@index([quotationId, eventAt])
  @@index([eventAt])
}

/// Mirrors BookingExtraServiceLine: additional/optional services attached to one specific
/// QuotationEvent (nullable eventId = quotation-level, unused today but kept for symmetry).
model QuotationExtraServiceLine {
  id                  String                  @id @default(uuid())
  quotationId         String
  eventId             String?
  extraServiceId      String
  quantity            Int                     @default(1)
  unitPriceSnapshot   Decimal                 @db.Decimal(12, 2)
  lineTotal           Decimal                 @db.Decimal(12, 2)
  titleSnapshot       String
  pricingTypeSnapshot ExtraServicePricingType
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  quotation    Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  event        QuotationEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  extraService ExtraService    @relation(fields: [extraServiceId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([quotationId, eventId])
  @@index([extraServiceId])
}

/// Caterer-owned persisted ingredient supply lists (standalone MVP; not tied to bookings unless linked).
model SupplySavedList {
  id              String                @id @default(uuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?                 @relation("SupplySavedListCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  title           String                @db.VarChar(512)
  bookingEventId  String?
  bookingEvent    BookingEvent?         @relation(fields: [bookingEventId], references: [id], onDelete: SetNull)
  categoriesLabel String?               @db.VarChar(512)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  items           SupplySavedListItem[]

  @@index([businessId, createdAt(sort: Desc)])
  @@index([bookingEventId])
}

model SupplySavedListItem {
  id           String          @id @default(uuid())
  listId       String
  list         SupplySavedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  supplyItemId String
  supplyItem   SupplyItem      @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)
  quantity     Int
  unit         String
  categorySlug String
  nameSnapshot Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([listId])
  @@index([supplyItemId])
}

model Vendor {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  whatsappNo   String?
  categorySlug String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, isActive])
}

model Staff {
  id          String       @id @default(uuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  role        StaffRole
  dailyCharge Decimal?     @db.Decimal(12, 2)
  status      StaffStatus  @default(AVAILABLE)
  isAvailable Boolean      @default(true)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments EventStaff[]

  @@index([businessId, role, isActive])
}

model EventStaff {
  id               String       @id @default(uuid())
  bookingEventId   String
  staffId          String
  role             StaffRole
  assignedByUserId String?
  allowConflict    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  bookingEvent     BookingEvent @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  staff            Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([bookingEventId, staffId])
  @@index([staffId])
  @@index([bookingEventId])
}

model ExtraService {
  id              String                      @id @default(uuid())
  businessId      String?
  business        Business?                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?                       @relation(fields: [createdByUserId], references: [id])
  /// false only when both businessId and createdByUserId are set; otherwise true (catalog / admin).
  isGlobal        Boolean                     @default(false)
  title           String
  description     String?                     @db.Text
  pricingType     ExtraServicePricingType
  price           Decimal                     @db.Decimal(12, 2)
  isOptional      Boolean                     @default(true)
  isActive        Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  bookingLines    BookingExtraServiceLine[]
  quotationLines  QuotationExtraServiceLine[]

  @@index([businessId, isActive])
  @@index([createdByUserId])
  @@index([isGlobal])
}

model BookingExtraServiceLine {
  id                  String                  @id @default(uuid())
  bookingId           String
  eventId             String?
  extraServiceId      String
  quantity            Int                     @default(1)
  unitPriceSnapshot   Decimal                 @db.Decimal(12, 2)
  lineTotal           Decimal                 @db.Decimal(12, 2)
  titleSnapshot       String
  pricingTypeSnapshot ExtraServicePricingType
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  booking             Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event               BookingEvent?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  extraService        ExtraService            @relation(fields: [extraServiceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([bookingId, eventId])
  @@index([extraServiceId])
}

model OnboardingReminder {
  id           String   @id @default(uuid())
  userId       String
  reminderType String
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reminderType])
  @@index([userId])
}

model BookingReminder {
  id           String   @id @default(uuid())
  bookingId    String
  reminderType String
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, reminderType])
  @@index([bookingId])
}

model QuotationReminder {
  id           String    @id @default(uuid())
  quotationId  String
  reminderType String
  sentAt       DateTime  @default(now())
  createdAt    DateTime  @default(now())
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, reminderType])
  @@index([quotationId])
}
